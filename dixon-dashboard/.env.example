# CallGrid — mismos valores que en los GitHub Secrets de royalspace-automations
CALLGRID_API_KEY=
CALLGRID_ORG_ID=

# Base de datos — Railway provee esto automáticamente al agregar el addon de Postgres
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dixon_dashboard

# Sesión — genera un valor aleatorio nuevo, ej: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Bootstrap del primer usuario ROYALSPACE_ADMIN (solo se usa si no existe ningún admin aún)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Timezone de reporte para las semanas de liquidación (Lunes-Domingo)
REPORTING_TIMEZONE=America/New_York
