# CallGrid — mismos valores que en los GitHub Secrets de royalspace-automations
CALLGRID_API_KEY=
CALLGRID_ORG_ID=

# Base de datos — Railway provee esto automáticamente al agregar el addon de Postgres
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dc_dashboard

# Sesión — genera un valor aleatorio nuevo, ej: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Bootstrap del primer usuario ROYALSPACE_ADMIN (solo se usa si no existe ningún admin aún)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Datos demo (usuarios @example.com + 3 liquidaciones de enero 2026) — solo para
# desarrollo local. NO poner en Railway: sin esto, el seed borra los datos demo si existen.
SEED_DEMO_DATA=true

# Timezone de reporte para las semanas de liquidación (Lunes-Domingo)
REPORTING_TIMEZONE=America/New_York

# Meta Ads — opcional. Sin esto, el ad spend sigue siendo 100% manual.
# Necesita permiso de lectura (ads_read) sobre la cuenta configurada por
# media buyer en /admin/media-buyers (campo "Cuenta de Meta Ads").
META_ACCESS_TOKEN=
META_API_VERSION=v25.0
